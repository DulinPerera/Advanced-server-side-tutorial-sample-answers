<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Tut11 Ex1 — Home</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>Welcome to Tut11 Exercise 1</h1>
    <p>This app demonstrates <strong>CSRF attacks</strong> and how to mitigate them with CSRF tokens.</p>

    <% if (user) { %>
      <p>Logged in as <strong><%= user.name %></strong></p>
      <a href="/auth/dashboard" class="btn">Go to Dashboard</a>
    <% } else { %>
      <a href="/auth/login" class="btn">Login</a>
      <a href="/auth/register" class="btn secondary">Register</a>
    <% } %>

    <hr>
    <p class="danger-zone">⚠️ <a href="/attack">Simulate CSRF Attack</a></p>
  </div>
</body>
</html>

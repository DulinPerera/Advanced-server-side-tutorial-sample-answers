<!DOCTYPE html>
<html>
<head>
  <title>Alumni Profile Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body { font-family: Arial, sans-serif; background: #f4f7f6; margin: 0; padding: 20px; }
    .container { max-width: 900px; margin: auto; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    h2, h3 { color: #333; }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ddd; padding-bottom: 15px; margin-bottom: 20px; }
    .header a { color: #d9534f; text-decoration: none; font-weight: bold; }
    .profile-card { display: flex; gap: 20px; align-items: flex-start; margin-bottom: 30px; }
    .profile-image { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; background: #eee; }
    .form-group { margin-bottom: 15px; }
    label { display: block; font-weight: bold; margin-bottom: 5px; }
    input, select { width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
    button { padding: 10px 15px; background: #007bff; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    button:hover { background: #0056b3; }
    .btn-danger { background: #d9534f; padding: 5px 10px; text-decoration: none; color: white; border-radius: 3px; font-size: 14px; }
    .btn-danger:hover { background: #c9302c; }
    .table-list { width: 100%; border-collapse: collapse; margin-top: 15px; }
    .table-list th, .table-list td { padding: 10px; border: 1px solid #ddd; text-align: left; }
    .message { color: green; margin-bottom: 15px; font-weight: bold; }
    .card-section { margin-bottom: 40px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Welcome, <%= user.full_name %>!</h2>
      <a href="/logout">Logout</a>
    </div>

    <% if (hasMessages) { %>
      <div class="message">
        <% messages.forEach(function(msg){ %>
          <p><%= msg %></p>
        <% }) %>
      </div>
    <% } %>

    <div class="card-section">
      <h3>Basic Profile Settings</h3>
      <div class="profile-card">
        <div>
          <img src="<%= user.profile_image || 'https://via.placeholder. ১৫০' %>" alt="Profile Image" class="profile-image">
          <form action="/profile/upload" method="POST" enctype="multipart/form-data" style="margin-top:10px;">
            <input type="file" name="profile_image" required style="font-size: 12px; margin-bottom: 5px;">
            <button type="submit" style="font-size: 12px; padding: 5px 10px;">Upload Image</button>
          </form>
        </div>
        <div style="flex-grow: 1;">
          <form action="/profile/update" method="POST">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="full_name" value="<%= user.full_name %>" required>
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" value="<%= user.email %>" disabled>
            </div>
            <div class="form-group">
              <label>LinkedIn Profile URL</label>
              <input type="url" name="linkedin_profile" value="<%= user.linkedin_profile || '' %>" placeholder="https://linkedin.com/in/username">
            </div>
            <button type="submit">Update Information</button>
          </form>
        </div>
      </div>
    </div>

    <div class="card-section">
      <h3>Qualifications & Certifications</h3>
      <table class="table-list">
        <tr>
          <th>Type</th><th>Name</th><th>Institution</th><th>Year</th><th>Action</th>
        </tr>
        <% qualifications.forEach(function(q) { %>
        <tr>
          <td><%= q.type %></td><td><%= q.name %></td><td><%= q.institution %></td><td><%= q.year %></td>
          <td><a href="/profile/qualification/<%= q.id %>/delete" class="btn-danger" onclick="return confirm('Delete this qualification?');">Delete</a></td>
        </tr>
        <% }) %>
      </table>
      <form action="/profile/qualification" method="POST" style="margin-top: 15px; display: flex; gap: 10px; align-items: flex-end;">
        <div>
          <label>Type</label>
          <select name="type" required>
            <option value="Degree">Degree</option>
            <option value="Certification">Certification</option>
            <option value="License">License</option>
            <option value="Course">Professional Course</option>
          </select>
        </div>
        <div><label>Name</label><input type="text" name="name" required placeholder="e.g. BSc Computer Science"></div>
        <div><label>Institution</label><input type="text" name="institution" required placeholder="e.g. Univ of W"></div>
        <div><label>Year</label><input type="number" name="year" required placeholder="2024"></div>
        <button type="submit">Add</button>
      </form>
    </div>

    <div class="card-section">
      <h3>Employment History</h3>
      <table class="table-list">
        <tr>
          <th>Company</th><th>Role</th><th>Duration</th><th>Action</th>
        </tr>
        <% employments.forEach(function(e) { %>
        <tr>
          <td><%= e.company %></td><td><%= e.role %></td>
          <td><%= e.start_year %> - <%= e.end_year ? e.end_year : 'Present' %></td>
          <td><a href="/profile/employment/<%= e.id %>/delete" class="btn-danger" onclick="return confirm('Delete this employment record?');">Delete</a></td>
        </tr>
        <% }) %>
      </table>
      <form action="/profile/employment" method="POST" style="margin-top: 15px; display: flex; gap: 10px; align-items: flex-end;">
        <div><label>Company</label><input type="text" name="company" required></div>
        <div><label>Role / Position</label><input type="text" name="role" required></div>
        <div><label>Start Year</label><input type="number" name="start_year" required placeholder="2020"></div>
        <div><label>End Year</label><input type="number" name="end_year" placeholder="Leave empty if Present"></div>
        <button type="submit">Add</button>
      </form>
    </div>
  </div>
</body>
</html>
